model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(PACIENTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@schema("unitroca")
}

enum Role {
  ADMIN
  MEDICO
  PACIENTE
  @@schema("unitroca")
}
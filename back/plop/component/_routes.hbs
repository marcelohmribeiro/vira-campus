import { Router } from "express";
import { {{pascalCase name}}Controller } from "#src/controllers";
{{#if useAuth}}
import { verifyJWT } from "#src/middlewares";
{{/if}}

const route = Router();
const { create, findAll, findById, update, deleteById } = {{pascalCase name}}Controller();

route.get("/", {{#if useAuth}}verifyJWT, {{/if}}findAll);
route.get("/:id", {{#if useAuth}}verifyJWT, {{/if}}findById);
route.post("/", {{#if useAuth}}verifyJWT, {{/if}}create);
route.put("/:id", {{#if useAuth}}verifyJWT, {{/if}}update);
route.delete("/:id", {{#if useAuth}}verifyJWT, {{/if}}deleteById);

export { {{pascalCase name}}Router };
export default {{pascalCase name}}Router;
